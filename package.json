{
  "name": "dsh-cookie-doctor",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "description": "治好 DeepSeek Harness 桌面版「Web authentication failed」无限重启崩溃：清理堆积的 dsh-auth-* cookie，并阻止它们再次堆积",
  "type": "module",
  "main": "./lib/index.js",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "cookie"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/simulate.mjs && node test/repair.test.mjs",
    "test:simulate": "node test/simulate.mjs",
    "test:repair": "node test/repair.test.mjs",
    "diagnose": "node scripts/diagnose.mjs",
    "repair": "node scripts/repair.mjs",
    "install-plugin": "node scripts/install.mjs"
  },
  "files": [
    "lib/",
    "scripts/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
